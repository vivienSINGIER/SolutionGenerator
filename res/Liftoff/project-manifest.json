{
  "schemaVersion": 1,

  "name": "Game",
  "kind": "ConsoleApp",

  "dependencies": ["Engine"],
  "exports": ["."],

  "defines": ["GAME_INTERNAL"],
  "exclude": ["experimental/**"],

  "vendor": {
    "fmt": {
      "include": ["fmt/include"],
      "libs": ["fmt.lib"],
      "libDirs": { "Debug": "fmt/lib/x64/Debug", "Release": "fmt/lib/x64/Release" },
      "dlls": []
    }
  },

  "configOverrides": {
    "Release": { "defines": ["GAME_SHIP"] }
  }
}
