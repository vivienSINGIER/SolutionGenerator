{
  "schemaVersion": 1,

  "name": "Game",
  "kind": "ConsoleApp",

  "dependencies": ["Engine"],
  "exports": ["."],

  "defines": ["GAME_INTERNAL"],
  "exclude": ["experimental/**"],

  "vendor": {
    "fmt": {
      "include": ["include"],
      "libs": [],
      "libDirs": ["lib/$(Platform)/$(Configuration)"],
      "dlls": [],
      "configs": {
        "Debug":   { "libs": ["fmtd.lib"] },
        "Release": { "libs": ["fmt.lib"] }
      }
    }
  },

  "configOverrides": {
    "Release": { "defines": ["GAME_SHIP"] }
  }
}
